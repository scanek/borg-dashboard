# Порт веб-дашборда
PORT=8099
TZ=Europe/Moscow

# Путь к диску с репозиториями на хосте (OMV диск dev-disk-by-uuid)
BORG_REPOS_HOST_PATH=/srv/dev-disk-by-uuid-YOUR-DISK-UUID

# Путь к логам на хосте
BORG_LOGS_DIR=/volume1/logs

# Путь к инструкции по восстановлению
BORG_GUIDE_PATH=/volume1/script/ИНСТРУКЦИЯ_ПО_ВОССТАНОВЛЕНИЮ.md

# Настройки первого репозитория
BORG_REPO_1_NAME=Docker & Контейнеры
BORG_REPO_1_PATH=/repos/borg_backup
BORG_REPO_1_HOST_PATH=/srv/dev-disk-by-uuid-YOUR-DISK-UUID/borg_backup
BORG_REPO_1_SOURCE=/volume1/docker
BORG_REPO_1_SCHEDULE=Ежедневно в 01:00

# Настройки второго репозитория
BORG_REPO_2_NAME=Immich Фото & База
BORG_REPO_2_PATH=/repos/backups/immich-borg
BORG_REPO_2_HOST_PATH=/srv/dev-disk-by-uuid-YOUR-DISK-UUID/backups/immich-borg
BORG_REPO_2_SOURCE=/volume1/immich
BORG_REPO_2_SCHEDULE=Ежедневно в 00:30
